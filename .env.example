# Dùng cho "docker compose --profile app". Copy thành .env rồi điền giá trị thật.
# Tạo nhanh:  openssl rand -base64 48  (JWT_SECRET)   |   openssl rand -base64 32  (ENCRYPTION_KEY)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes

POSTGRES_USER=root
POSTGRES_PASSWORD=rootpassword
POSTGRES_DB=autotest_db
FRONTEND_PORT=8080

SCHEDULE_TIMEZONE=Asia/Ho_Chi_Minh
RETENTION_RUN_DAYS=30
RETENTION_KEEP_RUNS_PER_PROJECT=20
RETENTION_EVENT_DAYS=7

# SMTP (tùy chọn) - cần để gửi mã OTP qua email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
