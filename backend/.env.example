DATABASE_URL="postgresql://root:rootpassword@localhost:5432/autotest_db?schema=public"
REDIS_URL="redis://localhost:6379/0"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
ENCRYPTION_KEY="replace-with-base64-encoded-32-random-bytes"
PORT=3000
WORKER_CONCURRENCY=5
WORKER_REQUEST_TIMEOUT_MS=5000
QUEUE_OPERATION_TIMEOUT_MS=5000

# Gmail SMTP: use a Google App Password, never your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your_google_app_password
# Optional; defaults to SMTP_USER
# SMTP_FROM="API Test Auto <your-email@gmail.com>"

# Lịch chạy định kỳ & dọn dẹp dữ liệu
SCHEDULE_TIMEZONE=Asia/Ho_Chi_Minh
RETENTION_RUN_DAYS=30
RETENTION_KEEP_RUNS_PER_PROJECT=20
RETENTION_EVENT_DAYS=7
RETENTION_AUDIT_DAYS=180

# Giới hạn tần suất (chống spam / brute-force). RATE_LIMIT_DISABLED=true để tắt khi demo.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_API_MAX=600
# Đặt khi chạy sau reverse proxy (nginx) để lấy đúng IP người dùng
# TRUST_PROXY=1

# URL giao dien, dung cho link trong thong bao Discord/Slack/Telegram
APP_BASE_URL=http://localhost:3001
