{
  "name": "backend",
  "version": "1.0.0",
  "description": "API Testing Tool Backend",
  "main": "src/server.ts",
  "scripts": {
    "start": "node build/backend/src/server.js",
    "start:worker": "node build/backend/src/worker.js",
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/server.ts",
    "dev:worker": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/worker.ts",
    "dev:sample-api": "ts-node-dev --respawn --transpile-only src/tests/fixtures/sample-api-entry.ts",
    "build": "tsc --outDir build",
    "test": "jest",
    "test:e2e": "jest --runInBand src/tests/system.e2e.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@readme/openapi-parser": "^2.5.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "axios": "^1.5.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^4.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "js-yaml": "^4.3.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "openapi-types": "^12.1.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.4",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.5.9",
    "@types/nodemailer": "^8.0.2",
    "jest": "^29.6.4",
    "prisma": "^5.0.0",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  }
}
